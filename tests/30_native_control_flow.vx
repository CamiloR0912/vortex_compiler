// Backend nativo, etapa 3: control de flujo.
// La salida esperada (30_native_control_flow.out) es la que produce la
// versión anterior del compilador, que traducía a C y usaba gcc.

// ---- if / else if / else ----
int n = -3;
if (n < 0) {
    print(n, -1);                   // rama if
} else if (n == 0) {
    print(n, 0);
} else {
    print(n, 1);
}
n = 0;
if (n < 0) { print(n, -1); } else if (n == 0) { print(n, 0); } else { print(n, 1); }
n = 8;
if (n < 0) { print(n, -1); } else if (n == 0) { print(n, 0); } else { print(n, 1); }

// if sin else: la condición falsa no ejecuta nada
if (n > 100) { print(100); }

// if anidados y condición con cortocircuito
bool par = n % 2 == 0;
if (par && n / 2 > 3) {
    if (n > 7) { print(true, n); } else { print(false, n); }
}

// el bloque del if abre un ámbito
if (true) {
    int n = 50;
    print(n);                       // 50
}
print(n);                           // 8

// ---- while: suma de 1 a 10 ----
int i = 1;
int total = 0;
while (i <= 10) {
    total = total + i;
    i = i + 1;
}
print(total);                       // 55

// while cuya condición es falsa desde el inicio
while (false) { print(999); }

// ---- for anidado: tabla de multiplicar ----
for (int i = 1; i <= 3; i = i + 1) {
    for (int j = 1; j <= 3; j = j + 1) {
        print(i, j, i * j);
    }
}
print(i);                           // 11: la i del for es otra variable

// for con asignación (sin declarar) y sin paso
int c = 5;
for (c = 5; c > 0; ) {
    print(c);
    c = c - 2;
}
print(c);                           // -1

// ---- while dentro de for: primos menores que 30 ----
for (int k = 2; k < 30; k = k + 1) {
    bool prime = true;
    int d = 2;
    while (d * d <= k && prime) {
        if (k % d == 0) { prime = false; }
        d = d + 1;
    }
    if (prime) { print(k); }
}

// ---- break y continue ----
for (int m = 1; m <= 10; m = m + 1) {
    if (m % 2 == 0) { continue; }   // salta los pares; el paso sí se ejecuta
    if (m > 7) { break; }           // termina en 9
    print(m);                       // 1 3 5 7
}

// continue en while
int w = 0;
int impares = 0;
while (w < 10) {
    w = w + 1;
    if (w % 2 == 0) { continue; }
    impares = impares + w;
}
print(impares);                     // 1 + 3 + 5 + 7 + 9 = 25

// break solo sale del ciclo más interno
for (int x = 1; x <= 3; x = x + 1) {
    for (int y = 1; y <= 3; y = y + 1) {
        if (y > x) { break; }
        print(x, y);
    }
}

// ciclo sin condición que termina con break
int pasos = 0;
for (;;) {
    pasos = pasos + 1;
    if (pasos == 4) { break; }
}
print(pasos);                       // 4

// while true con break y continue juntos
int z = 0;
while (true) {
    z = z + 1;
    if (z < 3) { continue; }
    print(z);
    if (z >= 5) { break; }
}
