// Backend nativo, etapa 6: try-catch, throw y assert.
// La salida esperada (34_native_exceptions.out) es la que produce la
// versión anterior del compilador, que traducía a C y usaba gcc.

// ---- Un error de ejecución se atrapa y el programa continúa ----
try {
    int a = 10;
    int b = 0;
    print("before the error");
    print(a / b);
    print("never printed");
} catch (e) {
    print("caught:", e);
}

// ---- El error ocurre varias llamadas más adentro ----
func int divide(int a, int b) { return a / b; }
func int middle(int x) { return divide(x, 0) + 1; }
try {
    print(middle(5));
} catch (e) {
    print("caught:", e);
}

// ---- assert con mensaje y sin mensaje ----
func float half_positive(float x) {
    assert(x >= 0, "x must be non-negative, got " + x);
    return x / 2;
}
try {
    print(half_positive(8.0));
    print(half_positive(-4));
} catch (err) {
    print("caught:", err);
}
try {
    assert(1 + 1 == 3);
} catch (e) {
    print("caught:", e);
}

// ---- throw de cada tipo: el catch recibe el valor como cadena ----
try { throw "a message"; } catch (e) { print(e); }
try { throw 42; } catch (e) { print(e + 1); }        // "421": es una cadena
try { throw 2.5; } catch (e) { print(e); }
try { throw false; } catch (e) { print(e); }

// ---- try anidados y relanzar ----
try {
    try {
        throw "inner problem";
    } catch (e) {
        print("inner caught:", e);
        throw "rethrown -> " + e;
    }
} catch (e) {
    print("outer caught:", e);
}

// ---- try dentro de un ciclo: continue y break salen del try ----
int ok = 0;
for (int d = 0; d < 6; d = d + 1) {
    try {
        if (d == 4) { break; }              // sale del try y del ciclo
        int q = 100 / (d - 2);
        if (d == 1) { continue; }           // sale del try sin error
        ok = ok + 1;
        print("  100 /", d - 2, "=", q);
    } catch (e) {
        print("  skip", d, "->", e);
    }
}
print("ok:", ok);
// si continue y break no retiraran sus manejadores, este error iría a
// un catch viejo en lugar de terminar el programa con el mensaje correcto
try {
    print(1 / 0);
} catch (e) {
    print("after the loop:", e);
}

// ---- return dentro de un try ----
func int safe_div(int a, int b) {
    try {
        return a / b;
    } catch (e) {
        return -1;
    }
}
print(safe_div(10, 2), safe_div(1, 0), safe_div(9, 3));
try {
    print(5 / 0);
} catch (e) {
    print("after return in try:", e);
}

// ---- Recursión sin fin atrapada; la profundidad se recupera ----
func int forever(int n) { return forever(n + 1); }
func int fact(int n) {
    if (n <= 1) { return 1; }
    return n * fact(n - 1);
}
try {
    print(forever(0));
} catch (e) {
    print("caught:", e);
}
print("fact(6) after recovering =", fact(6));

// ---- La variable del catch es local a su bloque ----
string e = "outer e";
try { throw "inner e"; } catch (e) { print(e); }
print(e);

// ---- Error al calcular un print: la línea no queda a medias ----
try {
    print("partial", 1 / 0);
} catch (e) {
    print("print failed:", e);
}

// ---- Sin catch que lo atrape: termina el programa ----
func void check(int age) {
    if (age < 0) { throw "invalid age: " + age; }
    print("age ok:", age);
}
check(20);
check(-5);
print("never printed");
