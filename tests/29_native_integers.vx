// Backend nativo, etapa 2: enteros, booleanos, variables, aritmética y print.
// La salida esperada (29_native_integers.out) es la que produce la versión
// anterior del compilador, que traducía a C y usaba gcc.

int a = 7;
int b = 2;
bool ok = true;

// ---- Precedencia y asociatividad ----
print(a + b * 3);                   // 13
print((a + b) * 3);                 // 27
print(a - b - 1);                   // 4: (a - b) - 1
print(-a + 10);                     // 3

// ---- División entera: se trunca hacia cero ----
print(a / b, a % b);                // 3 1
print(-7 / 2, -7 % 2);              // -3 -1
print(7 / -2, 7 % -2);              // -3 1

// ---- Comparaciones y operadores lógicos ----
print(a > b && !ok || a == 7);      // true: (true && false) || true
print(a != b, a <= b, a >= 7, ok == false);
print(ok, !ok, !!ok);

// ---- Cortocircuito: el operando derecho no se evalúa ----
print(false && 1 / 0 == 1, true || 1 / 0 == 1);

// ---- Valores de 64 bits ----
int big = 3000000000 * 3;
print(big);
print(9223372036854775807, -9223372036854775807 - 1);

// ---- Asignación y shadowing ----
a = a + 1;
print(a);                           // 8
{
    int a = a * 10;                 // la a de la derecha es la externa
    print(a);                       // 80
    {
        bool a = false;             // otra a, de otro tipo
        print(a);                   // false
    }
    print(a);                       // 80
}
print(a);                           // 8

// ---- print sin argumentos: línea vacía ----
print();

// ---- Error de ejecución: print evalúa todos sus valores antes de
//      imprimir, así que esta línea no se imprime a medias ----
print(a, 10 / (b - 2));
print(999);                         // no se ejecuta
