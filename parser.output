Grammar

    0 $accept: program $end

    1 program: stmt_list

    2 stmt_list: ε
    3          | stmt_list stmt

    4 stmt: var_decl
    5     | simple_stmt ';'
    6     | block
    7     | if_stmt
    8     | while_stmt
    9     | for_stmt
   10     | switch_stmt
   11     | func_def
   12     | try_stmt
   13     | jump_stmt
   14     | assert_stmt
   15     | print_stmt
   16     | invalid_stmt
   17     | error ';'
   18     | error block

   19 block: '{' stmt_list '}'

   20 basic_type: "int"
   21           | "float"
   22           | "bool"
   23           | "string"

   24 type: basic_type
   25     | "vector" '<' basic_type '>'
   26     | "matrix" '<' basic_type '>'

   27 var_decl: type "identifier" '=' expr ';'
   28         | type "identifier" ';'
   29         | "vector" "identifier" '=' expr ';'
   30         | "matrix" "identifier" '=' expr ';'

   31 simple_stmt: expr
   32            | expr '=' expr

   33 condition: '(' expr ')'
   34          | '(' expr '=' expr ')'
   35          | '(' error ')'

   36 if_stmt: "if" condition block
   37        | "if" condition block "else" block
   38        | "if" condition block "else" if_stmt

   39 $@1: ε

   40 if_stmt: "if" error $@1 block
   41        | "if" condition error ';'
   42        | "if" condition block "else" error ';'

   43 while_stmt: "while" condition block

   44 $@2: ε

   45 while_stmt: "while" error $@2 block
   46           | "while" condition error ';'

   47 for_stmt: "for" '(' for_init ';' expr_opt ';' for_step ')' block

   48 $@3: ε

   49 for_stmt: "for" '(' error ')' $@3 block
   50         | "for" '(' for_init ';' expr_opt ';' for_step ')' error ';'

   51 for_init: ε
   52         | type "identifier" '=' expr
   53         | simple_stmt

   54 for_step: ε
   55         | simple_stmt

   56 expr_opt: ε
   57         | expr

   58 switch_stmt: "switch" condition '{' case_list default_opt '}'
   59            | "switch" condition '{' case_list default_opt switch_error '}'

   60 switch_error: error block
   61             | error ';'
   62             | switch_error "case" expr ':' block
   63             | switch_error "default" ':' block

   64 case_list: ε
   65          | case_list "case" expr ':' block

   66 default_opt: ε
   67            | "default" ':' block

   68 func_def: "func" return_type "identifier" '(' params_opt ')' block
   69         | "func" return_type "identifier" '(' params_opt ')' ';'

   70 return_type: type
   71            | "void"

   72 params_opt: ε
   73           | param_list

   74 param_list: param
   75           | param_list ',' param

   76 param: type "identifier"
   77      | type "identifier" '=' expr

   78 try_stmt: "try" block "catch" '(' "identifier" ')' block
   79         | "try" block

   80 assert_stmt: "assert" '(' expr ')' ';'
   81            | "assert" '(' expr ',' expr ')' ';'
   82            | "assert" '(' ')' ';'

   83 jump_stmt: "return" ';'
   84          | "return" expr ';'
   85          | "break" ';'
   86          | "continue" ';'
   87          | "throw" expr ';'

   88 print_stmt: "print" '(' expr_list_opt ')' ';'

   89 invalid_stmt: "else" block
   90             | "else" if_stmt
   91             | "case" expr ':' block
   92             | "default" ':' block
   93             | "catch" '(' "identifier" ')' block

   94 expr: or_expr

   95 or_expr: and_expr
   96        | or_expr "||" and_expr

   97 and_expr: eq_expr
   98         | and_expr "&&" eq_expr

   99 eq_expr: rel_expr
  100        | eq_expr "==" rel_expr
  101        | eq_expr "!=" rel_expr

  102 rel_expr: add_expr
  103         | rel_expr '<' add_expr
  104         | rel_expr '>' add_expr
  105         | rel_expr "<=" add_expr
  106         | rel_expr ">=" add_expr

  107 add_expr: mul_expr
  108         | add_expr '+' mul_expr
  109         | add_expr '-' mul_expr

  110 mul_expr: unary
  111         | mul_expr '*' unary
  112         | mul_expr '/' unary
  113         | mul_expr '%' unary

  114 unary: postfix
  115      | '-' unary
  116      | '!' unary

  117 postfix: primary
  118        | postfix '[' expr ']'

  119 primary: "integer literal"
  120        | "float literal"
  121        | "string literal"
  122        | "boolean literal"
  123        | "identifier"
  124        | "identifier" '(' args_opt ')'
  125        | reduction '(' expr ')'
  126        | '(' expr ')'
  127        | '[' ']'
  128        | '[' expr_list ']'

  129 reduction: "sum"
  130          | "prod"
  131          | "max"
  132          | "min"
  133          | "len"

  134 expr_list_opt: ε
  135              | expr_list

  136 expr_list: expr
  137          | expr_list ',' expr

  138 args_opt: ε
  139         | arg_list

  140 arg_list: arg
  141         | arg_list ',' arg

  142 arg: expr
  143    | "identifier" '=' expr


